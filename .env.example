# Copy to .env and fill locally. Never commit .env.
# Ingest path for scripts/emit.py (dataway | datakit | ddtrace | otel). Default: dataway
# EMIT_MODE=dataway
#
# TrueWatch / OWL (API Key Management / Personal API Key → Secret — NOT Client Tokens; see runbook §3–4)
TRUEWATCH_API_KEY=
OWL_TOKEN=
OWL_API_KEY=
# OWL MCP / CLI registry (replace with your site; id1 example below)
# OWL_MCP_URL=https://id1-owl-mcp.truewatch.com/mcp
# OWL_REGISTRY_ENDPOINT=https://id1-owl-api.truewatch.com
# OWL_INSTALL_BASE_URL=https://static.truewatch.com/owl
# Legacy Tobylike MCP (contrast only; global host + SITE_KEY — id1 uses Endpoint=id2)
# TOBY_MCP_URL=https://us1-toby-ai.truewatch.com/toby_ai_mcp/mcp
# TOBY_MCP_SITE_KEY=id2
#
# Ingest — Workspace Token + DataWay (runbook §5; NOT the OWL API Key)
# Console: Management → Workspace Settings → Token
# DataWay host: Integrations → DataKit install command, or site table in runbook §2
# TRUEWATCH_WORKSPACE_TOKEN=
# DATAWAY_URL=https://id1-openway.truewatch.com
# DK_DATAWAY=https://id1-openway.truewatch.com?token=<TRUEWATCH_WORKSPACE_TOKEN>
#
# DataKit local HTTP (v0.0.2+) — emitter target; Compose sets http://datakit:9529
# DATAKIT_URL=http://127.0.0.1:9529
# EMIT_MODE=datakit
#
# DDTrace + StatsD (v0.0.3) — prefer Compose emit image (msgpack pinned)
# EMIT_MODE=ddtrace
# STATSD_HOST=127.0.0.1
# STATSD_PORT=8125
#
# OpenTelemetry OTLP (v0.0.4) — prefer Compose emit image (opentelemetry-proto)
# EMIT_MODE=otel
# DATAKIT_URL=http://127.0.0.1:9529
#
# Spaced repeats (all modes via scripts/emit.py) — Console-friendly Metrics points
# EMIT_COUNT=1
# EMIT_INTERVAL_SEC=5
#
# v0.2.0+ alert notify (N3) — mailGroup must target a **workspace member id**.
# Get UUID: Management → Members, or `owl exec owl.member.list` → member_uuid (shape acnt_…).
# scripts/tf-with-env.sh prefers LAB_ALERT_MEMBER_UUID over LAB_ALERT_EMAIL for TF_VAR_lab_alert_email.
# See docs/truewatch-tips.md (mailGroup tip).
LAB_ALERT_MEMBER_UUID=
# Optional fallback only if the address already appears in Member Management (not arbitrary external mail):
# LAB_ALERT_EMAIL=you@example.com
#
# Terraform provider (same API Key Secret as OWL; Open API host for site)
# TRUEWATCH_ACCESS_TOKEN=   # or rely on OWL_TOKEN when exporting in the runbook
# TRUEWATCH_END_POINT=https://id1-openapi.truewatch.com
# TF_VAR_lab_alert_email=   # set automatically by scripts/tf-with-env.sh from MEMBER_UUID or EMAIL

