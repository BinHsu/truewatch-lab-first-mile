# Copy to .env and fill locally. Never commit .env.
# Ingest path for scripts/emit.py (dataway | datakit | ddtrace). Default: dataway
# EMIT_MODE=dataway
#
# TrueWatch / OWL (API Key Management / Personal API Key → Secret — NOT Client Tokens; see runbook §3–4)
TRUEWATCH_API_KEY=
OWL_TOKEN=
OWL_API_KEY=
# OWL MCP / CLI registry (replace with your site; id1 example below)
# OWL_MCP_URL=https://id1-owl-mcp.truewatch.com/mcp
# OWL_REGISTRY_ENDPOINT=https://id1-owl-api.truewatch.com
# OWL_INSTALL_BASE_URL=https://static.truewatch.com/owl
#
# Ingest — Workspace Token + DataWay (runbook §5; NOT the OWL API Key)
# Console: Management → Workspace Settings → Token
# DataWay host: Integrations → DataKit install command, or site table in runbook §2
# TRUEWATCH_WORKSPACE_TOKEN=
# DATAWAY_URL=https://id1-openway.truewatch.com
# DK_DATAWAY=https://id1-openway.truewatch.com?token=<TRUEWATCH_WORKSPACE_TOKEN>
